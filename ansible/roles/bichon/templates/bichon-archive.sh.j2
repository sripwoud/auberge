#!/usr/bin/env bash
set -euo pipefail

: "${BICHON_BASE_URL:?required}"
: "${BICHON_API_TOKEN:?required}"
: "${BICHON_ARCHIVE_DIR:?required}"
: "${BICHON_ARCHIVE_STATE_DIR:?required}"
: "${BICHON_ARCHIVE_OVERLAP_SECONDS:={{ bichon_archive_overlap_seconds }}}"
: "${BICHON_ARCHIVE_PAGE_SIZE:={{ bichon_archive_page_size }}}"

OVERLAP_MS=$((BICHON_ARCHIVE_OVERLAP_SECONDS * 1000))
TOTAL_FAILURES=0

# Both write paths below stage through mktemp, which creates 0600 whatever the
# umask, and publish with mv, a same-filesystem rename that preserves the mode.
# The unit's UMask=0027 therefore never reaches an archived file, so the mode is
# set explicitly instead. It must stay group-readable: examples/bichon-expunge.sh
# counts .meta.json sidecars over ssh as a member of the archive group, without
# sudo, and unreadable sidecars make its coverage gate count zero.
ARCHIVE_FILE_MODE=0640

# Every message identity the account under work already holds, keyed the way
# ADR-0013 keys them. Rebuilt per account and added to as the run publishes, so
# the skip guard can ask whether a message is archived rather than whether a
# filename exists.
declare -A ARCHIVED_MESSAGE_IDS=()

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

curl_auth() {
  curl --silent --show-error --fail \
    --retry 5 --retry-all-errors --retry-delay 10 --retry-max-time 300 \
    --header "Authorization: Bearer ${BICHON_API_TOKEN}" \
    "$@"
}

verify_auth() {
  if ! curl_auth "${BICHON_BASE_URL}/api/v1/current-user" >/dev/null; then
    log "auth check failed: GET /api/v1/current-user did not return 2xx"
    exit 2
  fi
}

list_accounts() {
  curl_auth "${BICHON_BASE_URL}/api/v1/minimal-account-list?only_nosync=false"
}

search_messages() {
  local account_id="$1" since_ms="$2" page="$3"
  local payload
  payload=$(jq -nc \
    --argjson account_id "$account_id" \
    --argjson since "$since_ms" \
    --argjson page "$page" \
    --argjson page_size "$BICHON_ARCHIVE_PAGE_SIZE" \
    '{filter: {since: $since, account_ids: [$account_id]}, page: $page, page_size: $page_size, sort_by: "DATE", desc: false}')
  curl_auth \
    --header "Content-Type: application/json" \
    --request POST \
    --data "$payload" \
    "${BICHON_BASE_URL}/api/v1/search-messages"
}

search_tagged_messages() {
  local account_id="$1" tag="$2" page="$3"
  local payload
  payload=$(jq -nc \
    --argjson account_id "$account_id" \
    --arg tag "$tag" \
    --argjson page "$page" \
    --argjson page_size "$BICHON_ARCHIVE_PAGE_SIZE" \
    '{filter: {tags: [$tag], account_ids: [$account_id]}, page: $page, page_size: $page_size, sort_by: "DATE", desc: false}')
  curl_auth \
    --header "Content-Type: application/json" \
    --request POST \
    --data "$payload" \
    "${BICHON_BASE_URL}/api/v1/search-messages"
}

# The archive's proof that a payload is a message: at least one header field
# line, then the empty line RFC 5322 §2.1 puts between the headers and the body.
# curl cannot assert this — `--fail` judges the status code, and Bichon answers
# 200 with a zero-length body when its blob store holds no content for an
# envelope it still indexes, which is how a 0-byte .eml reached the corpus.
# `--retry-all-errors` retried nothing, because nothing reported an error.
#
# Reading stops at the separator, so this costs one page of a body rather than
# all of it, and awk's own failure to open the file is the answer "not a message"
# — which is what the caller asks of a path that does not exist yet.
#
# Deliberately not an equality check against the envelope's `size`: Bichon takes
# that from the IMAP server's RFC822.SIZE (`extractor.rs:54`) and rebuilds the
# served body by re-attaching detached attachments, so the number and the bytes
# have different producers and no documented reason to agree.
#
# Deliberately not "the first line is a header field" either: three bodies in the
# live corpus open with an mbox `From ` separator line, and a rule that rejects
# them would re-download all three on every run without ever converging.
has_header_block() {
  LC_ALL=C awk '
    /^\r?$/ { if (fields) separated = 1; exit }
    { fields = 1 }
    END { exit !separated }
  ' "$1" 2>/dev/null
}

download_message() {
  local account_id="$1" message_id="$2" out_path="$3"
  local tmp
  tmp=$(mktemp "${out_path}.XXXXXX")
  chmod "$ARCHIVE_FILE_MODE" "$tmp"
  if curl_auth --output "$tmp" \
      "${BICHON_BASE_URL}/api/v1/download-message/${account_id}/${message_id}"; then
    if has_header_block "$tmp"; then
      mv "$tmp" "$out_path"
      return 0
    fi
    log "download rejected id=${message_id} bytes=$(stat -c '%s' "$tmp") reason=no_header_block"
  fi
  rm -f "$tmp"
  return 1
}

# The archive's dedup key, read from the body rather than from Bichon's envelope
# because only the body survives re-import unchanged (ADR-0013). Canonical form
# is unfolded, trimmed, and stripped of one pair of angle brackets: RFC 5322
# folding puts the value on a continuation line for 108 bodies in the live
# corpus, which is what a naive '^Message-ID:' match gets wrong. A body with no
# Message-ID is keyed by its own sha256 — Bichon's synthetic id regenerates on
# re-import, so the hash is the only stable answer the backfill can also reach.
canonical_message_id() {
  local eml_path="$1" message_id digest
  message_id=$(LC_ALL=C awk '
    /^\r?$/ { exit }
    folded && /^[ \t]/ {
      continuation = $0
      sub(/^[ \t]+/, "", continuation)
      message_id = message_id continuation
      next
    }
    !found && tolower($0) ~ /^message-id:/ {
      message_id = $0
      sub(/^[^:]*:/, "", message_id)
      sub(/^[ \t]+/, "", message_id)
      found = 1
      folded = 1
      next
    }
    { folded = 0 }
    END {
      gsub(/\r/, "", message_id)
      sub(/[ \t]+$/, "", message_id)
      sub(/^</, "", message_id)
      sub(/>$/, "", message_id)
      print message_id
    }
  ' "$eml_path") || return 1

  if [ -z "$message_id" ]; then
    digest=$(sha256sum "$eml_path" | cut -d' ' -f1) || return 1
    [ -n "$digest" ] || return 1
    message_id="sha256:${digest}"
  fi
  printf '%s' "$message_id"
}

# Rewrites a sidecar to {folder, message_id}, keeping the folder it already
# records — an observation made at first sight that no pass may re-observe
# (ADR-0012:83). Fails without touching the sidecar if there is no folder to
# keep, and drops the `tags` field ADR-0012 left vestigial.
rekey_sidecar() {
  local meta_path="$1" message_id="$2"
  local tmp
  tmp=$(mktemp "${meta_path}.XXXXXX")
  chmod "$ARCHIVE_FILE_MODE" "$tmp"
  if ! jq --arg message_id "$message_id" \
    'if (.folder | type) == "string" then {folder, message_id: $message_id} else error("no folder") end' \
    "$meta_path" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$meta_path"
}

# Takes the identity rather than deriving it, because the caller has to read it
# first anyway: the skip guard decides whether to publish a body by asking
# whether the archive already holds that identity, which cannot be answered
# without reading it. One reader per body, and still only one implementation of
# the read (ADR-0013:132).
write_meta_sidecar() {
  local out_path="$1" message_id="$2" envelope_json="$3"
  local tmp
  tmp=$(mktemp "${out_path}.XXXXXX")
  chmod "$ARCHIVE_FILE_MODE" "$tmp"
  if ! printf '%s' "$envelope_json" \
    | jq --arg message_id "$message_id" '{folder: .mailbox_name, message_id: $message_id}' >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$out_path"
}

# Sidecars written before ADR-0013 record only `folder`. Repair them from the
# sibling body, which is the same immutable input the writer reads, so the pass
# is idempotent and converges in one run: grep finds nothing to do on every
# later tick. It rewrites the whole sidecar, which drops the `tags` field
# ADR-0012 left vestigial.
#
# A sidecar with no sibling body, or no `folder` to preserve, is not repairable
# here and fails the run rather than being skipped quietly — the coverage gate in
# examples/bichon-expunge.sh cannot count it either.
backfill_message_ids() {
  local safe_email="$1"
  local account_dir="${BICHON_ARCHIVE_DIR}/${safe_email}"
  [ -d "$account_dir" ] || return 0

  local stale
  stale=$(grep -rL --include='*.meta.json' -e '"message_id"' "$account_dir" || true)
  [ -z "$stale" ] && return 0

  local repaired=0 failures=0 meta eml message_id
  while IFS= read -r meta; do
    [ -z "$meta" ] && continue
    eml="${meta%.meta.json}.eml"
    if [ ! -f "$eml" ]; then
      log "backfill failed account=${safe_email} sidecar=${meta} reason=no_body"
      failures=$((failures + 1))
      continue
    fi
    if ! message_id=$(canonical_message_id "$eml"); then
      log "backfill failed account=${safe_email} sidecar=${meta} reason=unreadable_body"
      failures=$((failures + 1))
      continue
    fi
    if ! rekey_sidecar "$meta" "$message_id"; then
      log "backfill failed account=${safe_email} sidecar=${meta} reason=no_folder"
      failures=$((failures + 1))
      continue
    fi
    repaired=$((repaired + 1))
  done <<<"$stale"

  log "account=${safe_email} backfill repaired=${repaired} failures=${failures}"
  [ "$failures" -eq 0 ]
}

# The download-time refusal cannot reach a body already in the archive: the
# cursor advances past that message's date, so the search never offers its
# envelope again. Sweep for bodies that are not messages instead and re-download
# each by the envelope id its filename carries — the only identifier the archive
# can reconstruct without an envelope in hand.
#
# Sanctioned by the reasoning that put the sidecar backfill here (ADR-0013): the
# pass converges on the next hourly tick with no operator action, and it
# re-observes nothing. A payload that was never a message is a write that did
# not happen, not a fact to revise. The sidecar is re-keyed with it, because the
# body it was keyed on has changed: every empty body hashes alike, so the key it
# holds is `sha256:` of nothing.
#
# A body whose envelope Bichon no longer holds fails here on every run. That is
# the honest report — the archive does not have that message and cannot fetch it
# — and it clears when an operator deletes the body and its sidecar.
repair_broken_bodies() {
  local account_id="$1" safe_email="$2"
  local account_dir="${BICHON_ARCHIVE_DIR}/${safe_email}"
  [ -d "$account_dir" ] || return 0

  local repaired=0 failures=0 eml meta envelope_id message_id
  while IFS= read -r eml; do
    [ -z "$eml" ] && continue
    has_header_block "$eml" && continue

    envelope_id="${eml##*/}"
    envelope_id="${envelope_id%.eml}"
    if ! download_message "$account_id" "$envelope_id" "$eml"; then
      log "body repair failed account=${safe_email} body=${eml} reason=download"
      failures=$((failures + 1))
      continue
    fi

    meta="${eml%.eml}.meta.json"
    if [ ! -f "$meta" ]; then
      log "body repair failed account=${safe_email} body=${eml} reason=no_sidecar"
      failures=$((failures + 1))
      continue
    fi
    if ! message_id=$(canonical_message_id "$eml"); then
      log "body repair failed account=${safe_email} body=${eml} reason=unreadable_body"
      failures=$((failures + 1))
      continue
    fi
    if ! rekey_sidecar "$meta" "$message_id"; then
      log "body repair failed account=${safe_email} sidecar=${meta} reason=no_folder"
      failures=$((failures + 1))
      continue
    fi
    repaired=$((repaired + 1))
  done < <(find "$account_dir" -type f -name '*.eml')

  if [ "$repaired" -gt 0 ] || [ "$failures" -gt 0 ]; then
    log "account=${safe_email} body_repair repaired=${repaired} failures=${failures}"
  fi
  [ "$failures" -eq 0 ]
}

# Reads the identities the account's archive already holds, for the skip guard to
# test membership against. `<envelope-id>.eml` cannot answer that question:
# Bichon mints a fresh envelope id per import (ADR-0013), so when the v2 upgrade
# regenerated every id as a UUID the archived numeric filenames matched nothing
# the search returned. The guard answered "not archived" for all 9,394 bodies it
# held and one tick wrote 825 duplicates (#455). The 24h overlap window is what
# made that hourly rather than once: every tick re-lists a day of envelopes, not
# only the ones that arrived since the cursor.
#
# One jq over the account's sidecars, batched through xargs the way
# examples/bichon-expunge.sh batches its own walk (#406). Measured on the live
# corpus: 0.11s for all 9,396 sidecars across 7 accounts warm, beside the
# grep -rL the backfill already runs over the same files — no index earns its
# keep against that.
#
# A sidecar carrying no `message_id` contributes nothing rather than an empty
# key: backfill_message_ids runs first and has already failed the run over that
# exact file. An unreadable or unparseable one fails here, because a set that is
# quietly short of an entry is a duplicate written on the next tick.
load_archived_message_ids() {
  local safe_email="$1"
  local account_dir="${BICHON_ARCHIVE_DIR}/${safe_email}"

  ARCHIVED_MESSAGE_IDS=()
  [ -d "$account_dir" ] || return 0

  local ids message_id
  if ! ids=$(find "$account_dir" -type f -name '*.meta.json' -print0 \
    | xargs -0 -r jq -r '.message_id // empty'); then
    return 1
  fi

  while IFS= read -r message_id; do
    [ -z "$message_id" ] && continue
    ARCHIVED_MESSAGE_IDS["$message_id"]=1
  done <<<"$ids"
}

write_tag_snapshot() {
  local account_id="$1" safe_email="$2"
  local snapshot_path="${BICHON_ARCHIVE_DIR}/${safe_email}/tags.json"
  local all_tags
  if ! all_tags=$(curl_auth "${BICHON_BASE_URL}/api/v1/all-tags"); then
    log "all-tags failed account=${safe_email}"
    return 1
  fi

  mkdir -p "${BICHON_ARCHIVE_DIR}/${safe_email}"
  local tmp
  tmp=$(mktemp "${snapshot_path}.XXXXXX")
  chmod "$ARCHIVE_FILE_MODE" "$tmp"

  if [ "$(printf '%s' "$all_tags" | jq 'length')" -eq 0 ]; then
    printf '{}\n' >"$tmp"
    mv "$tmp" "$snapshot_path"
    log "account=${safe_email} tag_snapshot entries=0"
    return 0
  fi

  local pairs tag body page total_pages
  pairs=$(mktemp "${snapshot_path}.pairs.XXXXXX")

  while IFS= read -r tag; do
    [ -z "$tag" ] && continue
    page=1
    total_pages=1
    while [ "$page" -le "$total_pages" ]; do
      if ! body=$(search_tagged_messages "$account_id" "$tag" "$page"); then
        log "tag search failed account=${safe_email} tag=${tag} page=${page}"
        rm -f "$tmp" "$pairs"
        return 1
      fi
      total_pages=$(printf '%s' "$body" | jq -r '.total_pages // 0')
      printf '%s' "$body" | jq -c --arg tag "$tag" '.items[]? | {message_id, tag: $tag}' >>"$pairs"
      page=$((page + 1))
    done
  done < <(printf '%s' "$all_tags" | jq -r '.[].tag')

  jq -s 'group_by(.message_id) | map({key: .[0].message_id, value: (map(.tag) | sort)}) | from_entries' <"$pairs" >"$tmp"
  rm -f "$pairs"
  mv "$tmp" "$snapshot_path"
  log "account=${safe_email} tag_snapshot entries=$(jq 'length' "$snapshot_path")"
}

read_cursor() {
  local cursor_file="$1"
  if [ -f "$cursor_file" ]; then
    cat "$cursor_file"
  else
    printf '0'
  fi
}

write_cursor() {
  local cursor_file="$1" cursor_ms="$2"
  local tmp
  tmp=$(mktemp "${cursor_file}.XXXXXX")
  printf '%s\n' "$cursor_ms" >"$tmp"
  mv "$tmp" "$cursor_file"
}

sanitize_email() {
  printf '%s' "$1" | tr '/' '_'
}

process_account() {
  local account_id="$1" account_email="$2"
  local safe_email cursor_file cursor_ms since_ms
  safe_email=$(sanitize_email "$account_email")
  cursor_file="${BICHON_ARCHIVE_STATE_DIR}/${safe_email}.cursor"
  cursor_ms=$(read_cursor "$cursor_file")
  since_ms=$((cursor_ms - OVERLAP_MS))
  if [ "$since_ms" -lt 0 ]; then since_ms=0; fi

  log "account=${safe_email} id=${account_id} cursor_ms=${cursor_ms} since_ms=${since_ms}"

  # Both counted against the run, not against the account: an unrepairable entry
  # must fail the unit loudly, but freezing the cursor would stop archiving new
  # mail over a defect in an old one. Bodies first — the backfill keys sidecars
  # off the body beside them, so it must not read one this pass is about to
  # replace.
  if ! repair_broken_bodies "$account_id" "$safe_email"; then
    TOTAL_FAILURES=$((TOTAL_FAILURES + 1))
  fi
  if ! backfill_message_ids "$safe_email"; then
    TOTAL_FAILURES=$((TOTAL_FAILURES + 1))
  fi

  # After both repair passes, so it reads the sidecars they have finished
  # rewriting. Without the set the loop below cannot tell a message it holds from
  # one it does not, and downloading on that basis is what wrote the duplicates —
  # so this failing takes the account's pass with it rather than proceeding
  # blind. The cursor is not written, so nothing is skipped past.
  if ! load_archived_message_ids "$safe_email"; then
    log "identity set failed account=${safe_email} reason=unreadable_sidecars"
    TOTAL_FAILURES=$((TOTAL_FAILURES + 1))
    return 0
  fi

  local page=1
  local total_pages=1
  local max_date=$cursor_ms
  local account_failures=0
  local processed=0
  local skipped=0
  local deduped=0
  local body envelope id date_ms yyyy_mm out_dir eml_path meta_path
  local stage_path body_path message_id

  while [ "$page" -le "$total_pages" ]; do
    if ! body=$(search_messages "$account_id" "$since_ms" "$page"); then
      log "search_messages failed account=${safe_email} page=${page}"
      account_failures=$((account_failures + 1))
      break
    fi
    total_pages=$(printf '%s' "$body" | jq -r '.total_pages // 0')
    if [ "$total_pages" -eq 0 ]; then break; fi

    while IFS= read -r envelope; do
      [ -z "$envelope" ] && continue
      id=$(printf '%s' "$envelope" | jq -r '.id')
      date_ms=$(printf '%s' "$envelope" | jq -r '.date')

      if [ "$date_ms" -gt "$max_date" ]; then max_date=$date_ms; fi

      yyyy_mm=$(date -u -d "@$((date_ms / 1000))" '+%Y/%m')
      out_dir="${BICHON_ARCHIVE_DIR}/${safe_email}/${yyyy_mm}"
      eml_path="${out_dir}/${id}.eml"
      meta_path="${out_dir}/${id}.meta.json"

      # This envelope's own body, archived and keyed. Existence alone is not the
      # question: a 0-byte .eml satisfies `-f` and is not a message, so a file
      # guard promises coverage the archive does not have and never asks again.
      # Both guards read the same predicate, so a body that is not a message is
      # downloaded again on the next run the envelope appears in.
      #
      # This is the only skip a filename can decide, and it decides it for every
      # message archived under the envelope id regime currently in force. It says
      # nothing about a message archived under a previous one.
      if has_header_block "$eml_path" && [ -f "$meta_path" ]; then
        skipped=$((skipped + 1))
        continue
      fi

      mkdir -p "$out_dir"

      # Identity is read from the body, so a message the filename cannot vouch
      # for has to be fetched before it can be recognised. It is fetched to a
      # staging name — deliberately not matching `*.eml`, so repair_broken_bodies
      # cannot sweep a body that may never be published — and moved into place
      # only once the archive is known not to hold that message already.
      stage_path=''
      body_path="$eml_path"
      if ! has_header_block "$eml_path"; then
        stage_path="${eml_path}.incoming"
        body_path="$stage_path"
        if ! download_message "$account_id" "$id" "$stage_path"; then
          log "download failed account=${safe_email} id=${id}"
          account_failures=$((account_failures + 1))
          continue
        fi
      fi

      if ! message_id=$(canonical_message_id "$body_path"); then
        log "identity failed account=${safe_email} id=${id}"
        if [ -n "$stage_path" ]; then
          rm -f "$stage_path"
        fi
        account_failures=$((account_failures + 1))
        continue
      fi

      # The skip a filename could not perform, and the one the corpus needs: the
      # same message re-imported under a fresh envelope id is one message, not
      # two .eml files. Only a staged body is a candidate — a body already
      # published is in the corpus whichever identity it carries, and the sole
      # repair left for it is to key it. Discarding a redundant download is
      # right; leaving an existing body unkeyed is not, because the coverage gate
      # cannot count what has no sidecar.
      if [ -n "$stage_path" ] && [ -n "${ARCHIVED_MESSAGE_IDS["$message_id"]+archived}" ]; then
        rm -f "$stage_path"
        deduped=$((deduped + 1))
        continue
      fi

      if [ -n "$stage_path" ]; then
        mv "$stage_path" "$eml_path"
      fi

      if ! write_meta_sidecar "$meta_path" "$message_id" "$envelope"; then
        log "sidecar failed account=${safe_email} id=${id}"
        account_failures=$((account_failures + 1))
        continue
      fi
      ARCHIVED_MESSAGE_IDS["$message_id"]=1
      processed=$((processed + 1))
    done < <(printf '%s' "$body" | jq -c '.items[]?')

    page=$((page + 1))
  done

  # `skipped` and `deduped` are both "already archived", split because they prove
  # different things. A filename skip proves the id regime has not moved under
  # the corpus; an identity skip proves it has, and that the guard survived it.
  log "account=${safe_email} processed=${processed} skipped=${skipped} deduped=${deduped} failures=${account_failures}"

  if [ "$account_failures" -eq 0 ]; then
    write_cursor "$cursor_file" "$max_date"
  fi

  if ! write_tag_snapshot "$account_id" "$safe_email"; then
    account_failures=$((account_failures + 1))
  fi

  TOTAL_FAILURES=$((TOTAL_FAILURES + account_failures))
}

main() {
  mkdir -p "$BICHON_ARCHIVE_DIR" "$BICHON_ARCHIVE_STATE_DIR"
  verify_auth

  local accounts_json id email
  accounts_json=$(list_accounts)

  while IFS=$'\t' read -r id email; do
    [ -z "$id" ] && continue
    process_account "$id" "$email"
  done < <(printf '%s' "$accounts_json" | jq -r '.[] | "\(.id)\t\(.email)"')

  log "total_failures=${TOTAL_FAILURES}"
  if [ "$TOTAL_FAILURES" -gt 0 ]; then exit 1; fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
