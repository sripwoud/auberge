[Unit]
Description=Radio station encoder (Liquidsoap)
After=network.target icecast2.service
Requires=icecast2.service
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
User={{ radio_liquidsoap_user }}
Group={{ radio_liquidsoap_group }}
ExecStart=/usr/bin/liquidsoap {{ radio_config_dir }}/radio.liq
Environment=OCAMLRUNPARAM=o=40
Environment=LIQ_CACHE_USER_DIR=/var/cache/liquidsoap
Environment=LIQ_CACHE_SYSTEM_DIR=/var/cache/liquidsoap
Restart=on-failure
RestartSec=5
MemoryHigh={{ liquidsoap_memory_high }}
MemoryMax={{ liquidsoap_memory_max }}
CacheDirectory=liquidsoap
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
