# Single-quoted: systemd consumes a backslash in an unquoted value as an escape
# and strips trailing whitespace, so `p\ss` would silently reach aoe as `pss`
# and lock every device out with nothing reporting why. Single quotes are taken
# verbatim — the one character they cannot carry is a single quote, which the
# role refuses up front.
AOE_SERVE_PASSPHRASE='{{ aoe_passphrase }}'
