server_url: {{ headscale_server_url }}
listen_addr: 127.0.0.1:{{ headscale_port }}
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"
metrics_listen_addr: 127.0.0.1:{{ headscale_metrics_port }}
noise:
  private_key_path: {{ headscale_data_dir }}/noise_private.key
prefixes:
  v4: {{ headscale_ip_prefix_v4 }}
  v6: {{ headscale_ip_prefix_v6 }}
  allocation: sequential
derp:
  server:
    enabled: {{ headscale_derp_enabled | lower }}
    region_id: {{ headscale_derp_region_id }}
    region_code: self
    region_name: {{ headscale_derp_region_name }}
    stun_listen_addr: 0.0.0.0:{{ headscale_stun_port }}
    private_key_path: {{ headscale_data_dir }}/derp_private.key
{% if headscale_derp_urls | length > 0 %}
  urls:
{% for url in headscale_derp_urls %}
    - {{ url }}
{% endfor %}
  auto_update_enabled: true
  update_frequency: {{ headscale_derp_update_frequency }}
{% else %}
  urls: []
  auto_update_enabled: false
{% endif %}
database:
  type: sqlite
  sqlite:
    path: {{ headscale_db_path }}
    write_ahead_log: true
dns:
  magic_dns: {{ headscale_magic_dns_enabled | lower }}
  base_domain: {{ headscale_base_domain }}
  nameservers:
    global:
{% if headscale_tailscale_ipv4 is defined and headscale_tailscale_ipv4 | length > 0 %}
      - {{ headscale_tailscale_ipv4 }}
{% else %}
{% for nameserver in headscale_fallback_nameservers %}
      - {{ nameserver }}
{% endfor %}
{% endif %}
{% if headscale_split_dns_target_ip | length > 0 %}
    split:
      "{{ domain }}":
        - {{ headscale_split_dns_target_ip }}
{% endif %}
log:
  level: {{ headscale_log_level }}
logtail:
  enabled: false
